# Modelo do arquivo .env (este modelo vai para o GitHub; o .env de verdade não).
# Copie para um arquivo chamado .env, preencha e rode: node scripts/gerar-config.js
#
# Supabase > Project Settings > API Keys: URL do projeto e chave "anon"/"publishable".
# NUNCA use a chave "service_role"/"secret" aqui.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=COLE_A_CHAVE_PUBLICA_AQUI

# Usuário que aparece no login do painel e o e-mail cadastrado no Supabase Auth
ADMIN_USERNAME=thiago
ADMIN_EMAIL=thiago@telamax.local
